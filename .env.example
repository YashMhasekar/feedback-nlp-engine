# ============================================================
# Feedback NLP Engine - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git - it contains secrets.
# ============================================================

# ---- Google Gemini API Key ----
# Required for AI-generated summaries in nlp_test.py
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ---- Backend Server Config ----
# Port the Flask server runs on (default: 5002)
BACKEND_PORT=5002

# ---- Frontend URL (CORS) ----
# The origin React dev server runs on (default: 4010)
FRONTEND_URL=http://localhost:4010

# ---- File Upload Config ----
# Max upload size in bytes: 16777216 = 16 MB
MAX_FILE_SIZE=16777216
UPLOAD_FOLDER=uploads

# ---- JWT & Session Security ----
# CHANGE BOTH values to long random strings before deploying to production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_SECRET_KEY=change-this-jwt-secret-to-a-long-random-string-in-production
